# ==========================================
# SERVER
# ==========================================

PORT=3001
NODE_ENV=development


# ==========================================
# DATABASE
# ==========================================

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>

REDIS_URL=redis://localhost:6379


# ==========================================
# JWT
# ==========================================

# Replace with independent random values of at least 32 bytes.
JWT_ACCESS_SECRET=replace-with-a-strong-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-random-refresh-secret

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=90d


# ==========================================
# COOKIES
# ==========================================

COOKIE_SAMESITE=lax
COOKIE_SECURE=false


# ==========================================
# GOOGLE OAUTH
# ==========================================

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback


# ==========================================
# FACEBOOK OAUTH
# ==========================================

FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_GRAPH_API_VERSION=v23.0
FACEBOOK_CALLBACK_URL=http://localhost:3001/api/auth/facebook/callback


# ==========================================
# FRONTEND / CORS
# ==========================================

FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

OAUTH_SUCCESS_REDIRECT=http://localhost:3000
OAUTH_FAILURE_REDIRECT=http://localhost:3000


# ==========================================
# EMAIL / RESEND
# ==========================================

MAIL_FROM="FebRocket <hello@febrocket.com>"
RESEND_API_KEY=your_resend_api_key


# ==========================================
# RATE LIMITING
# ==========================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

PASSWORD_RATE_LIMIT_MAX=10


# ==========================================
# OTP
# ==========================================

OTP_TTL_MS=600000
USER_CACHE_TTL_SECONDS=60
OAUTH_STATE_TTL_SECONDS=600